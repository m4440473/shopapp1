generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String  @id @default(cuid())
  email               String  @unique
  name                String?
  role                String  @default("MACHINIST")
  active              Boolean @default(true)
  kioskEnabled        Boolean @default(false)
  kioskPinHash        String?
  primaryDepartmentId String?
  // Credentials provider (nullable)
  passwordHash        String?

  orders               Order[]                  @relation("AssignedOrders")
  quotes               Quote[]
  notes                Note[]
  timeLogs             TimeLog[]
  timeEntries          TimeEntry[]
  timeEntryActions     TimeEntryAction[]        @relation("TimeEntryActionActor")
  checklistToggles     OrderChecklist[]         @relation("ChecklistToggledBy")
  uploadedAttachments  Attachment[]             @relation("UserAttachments")
  statusHistories      StatusHistory[]          @relation("UserStatusHistory")
  partEvents           PartEvent[]
  partTimeAdjustments  PartTimeAdjustment[]
  partBomAnalyses      PartBomAnalysis[]
  performedChecklist   OrderChecklist[]         @relation("ChecklistPerformedBy")
  partAssignments      OrderPartAssignment[]    @relation("PartAssignmentUser")
  assignedPartWork     OrderPartAssignment[]    @relation("PartAssignmentAssignedBy")
  instructionReceipts  PartInstructionReceipt[]
  repeatOrderTemplates RepeatOrderTemplate[]    @relation("RepeatOrderTemplateCreatedBy")
  drawingImportJobs    DrawingImportJob[]       @relation("DrawingImportJobCreator")
  drawingProfiles      DrawingTitleBlockProfile[] @relation("DrawingTitleBlockProfileCreator")
  primaryDepartment    Department?              @relation("UserPrimaryDepartment", fields: [primaryDepartmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id            String  @id @default(cuid())
  name          String
  contact       String?
  phone         String?
  fax           String?
  email         String?
  address       String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  stateProvince String?
  postalCode    String?
  country       String?

  orders               Order[]
  quotes               Quote[]
  contacts             CustomerContact[]
  businesses           CustomerBusiness[]
  repeatOrderTemplates RepeatOrderTemplate[]
  drawingProfiles      DrawingTitleBlockProfile[]

  @@unique([name])
  @@index([name])
}

model CustomerBusiness {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessCode String
  sourceFile   String?
  createdAt    DateTime @default(now())

  @@unique([customerId, businessCode])
  @@index([businessCode])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  title      String?
  phone      String?
  fax        String?
  email      String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  quotes     Quote[]
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, sortOrder])
  @@index([customerId, name])
  @@index([email])
}

model Material {
  id    String  @id @default(cuid())
  name  String  @unique
  spec  String?
  notes String?

  parts                    OrderPart[]
  quoteParts               QuotePart[]               @relation("QuotePartMaterial")
  repeatOrderTemplateParts RepeatOrderTemplatePart[]
}

model Vendor {
  id        String  @id @default(cuid())
  name      String  @unique
  url       String?
  phone     String?
  contact   String?
  materials String?
  notes     String?

  orders                Order[]
  orderPartProcurements OrderPart[]           @relation("OrderPartProcurementVendor")
  quoteVendorItems      QuoteVendorItem[]
  quotePartProcurements QuotePart[]           @relation("QuotePartProcurementVendor")
  repeatOrderTemplates  RepeatOrderTemplate[]
}

model Order {
  id                   String                @id @default(cuid())
  sourceQuoteId        String?               @unique
  sourceQuote          Quote?                @relation("ConvertedQuoteOrder", fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  orderNumber          String                @unique
  business             String                @default("STD")
  customerId           String
  customer             Customer              @relation(fields: [customerId], references: [id])
  customerContactId    String?
  customerContact      CustomerContact?      @relation(fields: [customerContactId], references: [id], onDelete: SetNull)
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  status               String
  priority             String
  dueDate              DateTime
  receivedDate         DateTime
  modelIncluded        Boolean               @default(false)
  materialNeeded       Boolean               @default(false)
  materialOrdered      Boolean               @default(false)
  vendorId             String?
  vendor               Vendor?               @relation(fields: [vendorId], references: [id])
  poNumber             String?
  assignedMachinistId  String?
  assignedMachinist    User?                 @relation("AssignedOrders", fields: [assignedMachinistId], references: [id])
  parts                OrderPart[]
  checklist            OrderChecklist[]
  charges              OrderCharge[]
  attachments          Attachment[]
  partAttachments      PartAttachment[]
  notes                Note[]
  timeLogs             TimeLog[]
  timeEntries          TimeEntry[]
  statusHistory        StatusHistory[]
  partEvents           PartEvent[]
  partTimeAdjustments  PartTimeAdjustment[]
  bomAnalyses          PartBomAnalysis[]
  repeatOrderTemplates RepeatOrderTemplate[]
  createdAt            DateTime              @default(now())

  @@index([customerContactId])
}

model OrderPart {
  id                  String                   @id @default(cuid())
  orderId             String
  order               Order                    @relation(fields: [orderId], references: [id])
  partNumber          String
  partName            String?
  quantity            Int
  materialId          String?
  material            Material?                @relation(fields: [materialId], references: [id])
  drawingMaterialText String?
  drawingFinishText   String?
  finish              String?
  materialStatus      String                   @default("UNREVIEWED")
  inventoryLocation   String?
  materialNotes       String?
  procurementVendorId String?
  procurementVendor   Vendor?                  @relation("OrderPartProcurementVendor", fields: [procurementVendorId], references: [id], onDelete: SetNull)
  currentDepartmentId String?
  currentDepartment   Department?              @relation(fields: [currentDepartmentId], references: [id])
  notes               String?
  workInstructions    String?
  instructionsVersion Int                      @default(1)
  stockSize           String?
  cutLength           String?
  partWidth           String?
  partThickness       String?
  finalPartLength     String?
  drawingImportPageId String?
  drawingImportPage   DrawingImportPage?          @relation("OrderPartDrawingImportPage", fields: [drawingImportPageId], references: [id], onDelete: SetNull)
  status              String                   @default("IN_PROGRESS")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  charges             OrderCharge[]
  attachments         PartAttachment[]
  checklistItems      OrderChecklist[]
  timeEntries         TimeEntry[]
  partEvents          PartEvent[]
  timeAdjustments     PartTimeAdjustment[]
  bomAnalyses         PartBomAnalysis[]
  assignments         OrderPartAssignment[]
  instructionReceipts PartInstructionReceipt[]

  @@index([drawingImportPageId])
}

model OrderChecklist {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId        String?
  part          OrderPart?   @relation(fields: [partId], references: [id], onDelete: SetNull)
  chargeId      String?
  charge        OrderCharge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  addonId       String?
  addon         Addon?       @relation(fields: [addonId], references: [id])
  completed     Boolean      @default(false)
  isActive      Boolean      @default(true)
  toggledById   String?
  toggledBy     User?        @relation("ChecklistToggledBy", fields: [toggledById], references: [id])
  performedById String?
  performedBy   User?        @relation("ChecklistPerformedBy", fields: [performedById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([orderId, addonId, partId])
  @@unique([orderId, chargeId])
}

model Note {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model TimeLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  phase     String
  minutes   Int
  createdAt DateTime @default(now())
}

model TimeEntry {
  id           String            @id @default(cuid())
  orderId      String
  order        Order             @relation(fields: [orderId], references: [id])
  partId       String?
  part         OrderPart?        @relation(fields: [partId], references: [id])
  departmentId String?
  department   Department?       @relation(fields: [departmentId], references: [id])
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  operation    String
  startedAt    DateTime          @default(now())
  endedAt      DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  actions      TimeEntryAction[]

  @@index([userId, endedAt])
  @@index([userId, departmentId, endedAt])
  @@index([orderId])
  @@index([partId])
}

model TimeEntryAction {
  id          String    @id @default(cuid())
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?     @relation("TimeEntryActionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  reason      String?
  metadata    String?
  createdAt   DateTime  @default(now())

  @@index([timeEntryId, createdAt])
  @@index([actorUserId])
}

model PartEvent {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId    String
  part      OrderPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  message   String
  meta      String?
  createdAt DateTime  @default(now())

  @@index([orderId])
  @@index([partId])
  @@index([userId])
}

model PartTimeAdjustment {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId    String
  part      OrderPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  seconds   Int
  note      String
  createdAt DateTime  @default(now())

  @@index([orderId])
  @@index([partId])
  @@index([userId])
}

model PartBomAnalysis {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId       String
  part         OrderPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  analyzedById String?
  analyzedBy   User?     @relation(fields: [analyzedById], references: [id], onDelete: SetNull)
  resultJson   String
  sourceLabel  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([orderId, partId])
  @@index([partId])
  @@index([analyzedById])
}

model Attachment {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  url          String?
  storagePath  String?
  label        String?
  mimeType     String?
  uploadedById String?
  uploadedBy   User?    @relation("UserAttachments", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([storagePath])
}

model StatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  from      String
  to        String
  userId    String?
  user      User?    @relation("UserStatusHistory", fields: [userId], references: [id])
  reason    String?
  createdAt DateTime @default(now())
}

model Addon {
  id              String     @id @default(cuid())
  name            String
  description     String?
  rateType        String
  rateCents       Int
  active          Boolean    @default(true)
  affectsPrice    Boolean    @default(true)
  isChecklistItem Boolean    @default(true)
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])

  quoteSelections            QuoteAddonSelection[]
  orderChecklist             OrderChecklist[]
  orderCharges               OrderCharge[]
  repeatOrderTemplateCharges RepeatOrderTemplateCharge[] @relation("RepeatTemplateChargeAddon")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@index([active])
}

model Department {
  id                         String                      @id @default(cuid())
  name                       String                      @unique
  slug                       String                      @unique
  sortOrder                  Int                         @default(0)
  isActive                   Boolean                     @default(true)
  addons                     Addon[]
  charges                    OrderCharge[]
  timeEntries                TimeEntry[]
  checklistItems             OrderChecklist[]
  currentParts               OrderPart[]
  instructionReceipts        PartInstructionReceipt[]
  repeatOrderTemplateCharges RepeatOrderTemplateCharge[]
  primaryUsers               User[]                      @relation("UserPrimaryDepartment")
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
}

model OrderCharge {
  id             String           @id @default(cuid())
  orderId        String
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId         String?
  part           OrderPart?       @relation(fields: [partId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department       @relation(fields: [departmentId], references: [id])
  addonId        String?
  addon          Addon?           @relation(fields: [addonId], references: [id])
  checklistItems OrderChecklist[]
  kind           String
  name           String
  description    String?
  quantity       Decimal          @default(1)
  unitPrice      Decimal          @default(0)
  sortOrder      Int              @default(0)
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([orderId])
  @@index([partId])
  @@index([departmentId])
}

model PartAttachment {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId      String
  part        OrderPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  kind        String
  url         String?
  storagePath String?
  label       String?
  mimeType    String?
  createdAt   DateTime  @default(now())

  @@index([orderId])
  @@index([partId])
  @@index([storagePath])
}

model OrderPartAssignment {
  id             String    @id @default(cuid())
  partId         String
  part           OrderPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation("PartAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedById   String?
  assignedBy     User?     @relation("PartAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignmentType String    @default("WORKER")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  removedAt      DateTime?

  @@index([partId])
  @@index([userId])
  @@index([partId, userId, isActive])
}

model PartInstructionReceipt {
  id                  String     @id @default(cuid())
  partId              String
  part                OrderPart  @relation(fields: [partId], references: [id], onDelete: Cascade)
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId        String
  department          Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  instructionsVersion Int
  acknowledgedAt      DateTime   @default(now())

  @@unique([partId, userId, departmentId, instructionsVersion])
  @@index([partId])
  @@index([userId])
  @@index([departmentId])
}

model RepeatOrderTemplate {
  id              String                          @id @default(cuid())
  customerId      String
  customer        Customer                        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourceOrderId   String?
  sourceOrder     Order?                          @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)
  sourcePartId    String?                         @unique
  name            String
  business        String                          @default("STD")
  vendorId        String?
  vendor          Vendor?                         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  materialNeeded  Boolean                         @default(false)
  materialOrdered Boolean                         @default(false)
  modelIncluded   Boolean                         @default(false)
  priority        String                          @default("NORMAL")
  notes           String?
  createdById     String?
  createdBy       User?                           @relation("RepeatOrderTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  parts           RepeatOrderTemplatePart[]
  attachments     RepeatOrderTemplateAttachment[]
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  @@index([customerId])
  @@index([sourceOrderId])
  @@index([createdById])
}

model RepeatOrderTemplatePart {
  id                  String                          @id @default(cuid())
  templateId          String
  template            RepeatOrderTemplate             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  partNumber          String
  partName            String?
  quantity            Int
  materialId          String?
  material            Material?                       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  workInstructions    String?
  instructionsVersion Int                             @default(1)
  notes               String?
  stockSize           String?
  cutLength           String?
  partWidth           String?
  partThickness       String?
  sortOrder           Int                             @default(0)
  charges             RepeatOrderTemplateCharge[]
  attachments         RepeatOrderTemplateAttachment[]
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  @@index([templateId])
  @@index([materialId])
}

model RepeatOrderTemplateCharge {
  id             String                  @id @default(cuid())
  templatePartId String
  templatePart   RepeatOrderTemplatePart @relation(fields: [templatePartId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department              @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  addonId        String?
  addon          Addon?                  @relation("RepeatTemplateChargeAddon", fields: [addonId], references: [id], onDelete: SetNull)
  kind           String
  name           String
  description    String?
  quantity       Decimal                 @default(1)
  unitPrice      Decimal                 @default(0)
  sortOrder      Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([templatePartId])
  @@index([departmentId])
}

model RepeatOrderTemplateAttachment {
  id             String                   @id @default(cuid())
  templateId     String
  template       RepeatOrderTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templatePartId String?
  templatePart   RepeatOrderTemplatePart? @relation(fields: [templatePartId], references: [id], onDelete: Cascade)
  kind           String                   @default("OTHER")
  url            String?
  storagePath    String?
  label          String?
  mimeType       String?
  sortOrder      Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([templateId])
  @@index([templatePartId])
  @@index([storagePath])
}

model Quote {
  id                String           @id @default(cuid())
  quoteNumber       String
  business          String           @default("STD")
  companyName       String
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  customerId        String?
  customer          Customer?        @relation(fields: [customerId], references: [id])
  customerContactId String?
  customerContact   CustomerContact? @relation(fields: [customerContactId], references: [id], onDelete: SetNull)
  status            String           @default("DRAFT")
  materialSummary   String?
  purchaseItems     String?
  requirements      String?
  notes             String?
  multiPiece        Boolean          @default(false)
  basePriceCents    Int              @default(0)
  addonsTotalCents  Int              @default(0)
  vendorTotalCents  Int              @default(0)
  totalCents        Int              @default(0)
  workflowStep      Int              @default(0)
  metadata          String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  parts           QuotePart[]
  vendorItems     QuoteVendorItem[]
  addonSelections QuoteAddonSelection[]
  attachments     QuoteAttachment[]
  partAttachments QuotePartAttachment[]
  convertedOrder  Order?                @relation("ConvertedQuoteOrder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quoteNumber])
  @@index([status])
  @@index([companyName])
  @@index([customerContactId])
}

model QuotePart {
  id                       String                @id @default(cuid())
  quoteId                  String
  quote                    Quote                 @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name                     String
  description              String?
  quantity                 Int                   @default(1)
  pieceCount               Int                   @default(1)
  notes                    String?
  workInstructions         String?
  partNumber               String?
  materialId               String?
  material                 Material?             @relation("QuotePartMaterial", fields: [materialId], references: [id])
  drawingMaterialText      String?
  drawingFinishText        String?
  finish                   String?
  stockSize                String?
  cutLength                String?
  partWidth                String?
  partThickness            String?
  finalPartLength          String?
  drawingImportPageId      String?
  drawingImportPage        DrawingImportPage?     @relation("QuotePartDrawingImportPage", fields: [drawingImportPageId], references: [id], onDelete: SetNull)
  materialStatus           String                @default("UNREVIEWED")
  inventoryLocation        String?
  materialNotes            String?
  procurementVendorId      String?
  procurementVendor        Vendor?               @relation("QuotePartProcurementVendor", fields: [procurementVendorId], references: [id], onDelete: SetNull)
  procurementCostCents     Int?
  procurementMarkupPercent Float?
  sortOrder                Int                   @default(0)
  addonSelections          QuoteAddonSelection[]
  attachments              QuotePartAttachment[]

  @@index([quoteId, sortOrder])
  @@index([procurementVendorId])
  @@index([drawingImportPageId])
}

model QuoteVendorItem {
  id              String  @id @default(cuid())
  quoteId         String
  quote           Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  vendorId        String?
  vendor          Vendor? @relation(fields: [vendorId], references: [id])
  vendorName      String?
  partNumber      String?
  partUrl         String?
  basePriceCents  Int     @default(0)
  markupPercent   Float   @default(0)
  finalPriceCents Int     @default(0)
  notes           String?
}

model QuoteAddonSelection {
  id                      String     @id @default(cuid())
  quoteId                 String
  quote                   Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quotePartId             String?
  quotePart               QuotePart? @relation(fields: [quotePartId], references: [id], onDelete: Cascade)
  addonId                 String
  addon                   Addon      @relation(fields: [addonId], references: [id])
  units                   Float      @default(0)
  rateTypeSnapshot        String
  rateCents               Int
  totalCents              Int
  affectsPriceSnapshot    Boolean    @default(true)
  isChecklistItemSnapshot Boolean    @default(true)
  departmentIdSnapshot    String?
  nameSnapshot            String?
  notes                   String?

  @@unique([quotePartId, addonId])
  @@index([quotePartId])
}

model QuoteAttachment {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  url         String?
  storagePath String?
  label       String?
  mimeType    String?
  createdAt   DateTime @default(now())

  @@index([storagePath])
}

model QuotePartAttachment {
  id          String    @id @default(cuid())
  quoteId     String
  quote       Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quotePartId String
  quotePart   QuotePart @relation(fields: [quotePartId], references: [id], onDelete: Cascade)
  kind        String    @default("DWG")
  url         String?
  storagePath String?
  label       String?
  mimeType    String?
  createdAt   DateTime  @default(now())

  @@index([quoteId])
  @@index([quotePartId])
  @@index([storagePath])
}

model AppSettings {
  id                        String   @id @default("singleton")
  companyName               String   @default("Shopapp1")
  logoPath                  String?
  themePrimary              String   @default("#0ea5e9")
  themeAccent               String   @default("#a855f7")
  attachmentsDir            String   @default("/app/storage")
  requirePOForQuoteApproval Boolean  @default(true)
  requirePOForQuoteToOrder  Boolean  @default(false)
  drawingImportLunaFallbackEnabled Boolean @default(false)
  invoiceTemplateId         String   @default("classic")
  invoiceOptions            String?
  shopFloorDisplayOptions   String?
  updatedAt                 DateTime @updatedAt
}

model CustomField {
  id           String              @id @default(cuid())
  entityType   String
  name         String
  key          String              @unique
  fieldType    String
  description  String?
  businessCode String?
  defaultValue String?
  isRequired   Boolean             @default(false)
  isActive     Boolean             @default(true)
  sortOrder    Int                 @default(0)
  uiSection    String              @default("INTAKE")
  options      CustomFieldOption[]
  values       CustomFieldValue[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([entityType])
  @@index([businessCode])
  @@index([isActive])
}

model CustomFieldOption {
  id        String      @id @default(cuid())
  fieldId   String
  field     CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  label     String
  value     String
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)

  @@index([fieldId])
}

model CustomFieldValue {
  id        String      @id @default(cuid())
  fieldId   String
  field     CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  entityId  String
  value     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([fieldId, entityId])
  @@index([entityId])
}

model DocumentTemplate {
  id             String                    @id @default(cuid())
  name           String
  documentType   String
  description    String?
  businessCode   String?
  isDefault      Boolean                   @default(false)
  isActive       Boolean                   @default(true)
  schemaVersion  Int                       @default(1)
  currentVersion Int                       @default(1)
  layoutJson     String
  versions       DocumentTemplateVersion[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([documentType])
  @@index([businessCode])
  @@index([isDefault])
  @@index([isActive])
}

model DocumentTemplateVersion {
  id            String           @id @default(cuid())
  templateId    String
  template      DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version       Int
  schemaVersion Int
  layoutJson    String
  createdAt     DateTime         @default(now())

  @@unique([templateId, version])
  @@index([templateId])
}

model DrawingImportJob {
  id                    String                @id @default(cuid())
  idempotencyKey        String                @unique
  createdById           String?
  createdBy             User?                 @relation("DrawingImportJobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  destination           String
  business              String
  customerName          String
  draftReference        String
  intakeMode            String
  assemblyMultiplier    Int                   @default(1)
  pipelineVersion       String
  mode                   String
  status                 String                @default("QUEUED")
  stage                  String                @default("queued")
  configJson             String
  countsJson             String?
  timingJson             String?
  estimatedCostUsd       Float                 @default(0)
  actualCostUsd          Float                 @default(0)
  softBudgetUsd          Float
  hardBudgetUsd          Float
  errorSummary           String?
  cancelRequestedAt      DateTime?
  startedAt              DateTime?
  firstPageReadyAt       DateTime?
  completedAt            DateTime?
  lastHeartbeatAt        DateTime?
  sources                DrawingImportSource[]
  pages                  DrawingImportPage[]
  bomRows                DrawingImportBomRow[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([status, updatedAt])
  @@index([createdById, createdAt])
  @@index([draftReference])
}

model DrawingImportSource {
  id                String              @id @default(cuid())
  jobId             String
  job               DrawingImportJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceKind        String
  originalFilename  String
  archivePath       String?
  mimeType          String
  sizeBytes         Int
  sha256            String
  storagePath       String
  pageCount         Int?
  warningsJson      String?
  pages             DrawingImportPage[]
  createdAt         DateTime            @default(now())

  @@index([jobId])
  @@index([sha256])
  @@index([storagePath])
}

model DrawingImportPage {
  id                       String                    @id @default(cuid())
  jobId                    String
  job                      DrawingImportJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceId                 String
  source                   DrawingImportSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourcePageNumber         Int
  sourceFilename           String
  canonicalPdfStoragePath  String?
  previewStoragePath       String?
  contentSha256            String
  perceptualHash           String?
  width                    Float
  height                   Float
  rotation                 Int                       @default(0)
  classification           String                    @default("uncertain")
  classificationConfidence Float                     @default(0)
  localExtractionJson      String?
  finalExtractionJson      String?
  reviewStatus             String                    @default("PENDING")
  routeTier                String                    @default("local")
  warningsJson             String?
  duplicateOfPageId        String?
  duplicateOfPage          DrawingImportPage?        @relation("DrawingImportPageDuplicate", fields: [duplicateOfPageId], references: [id], onDelete: SetNull)
  duplicates               DrawingImportPage[]       @relation("DrawingImportPageDuplicate")
  attempts                 DrawingExtractionAttempt[]
  bomRows                  DrawingImportBomRow[]
  parentEdges              DrawingImportBomEdge[]    @relation("DrawingImportParentPage")
  childEdges               DrawingImportBomEdge[]    @relation("DrawingImportChildPage")
  quoteParts               QuotePart[]               @relation("QuotePartDrawingImportPage")
  orderParts               OrderPart[]               @relation("OrderPartDrawingImportPage")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([sourceId, sourcePageNumber])
  @@index([jobId, reviewStatus])
  @@index([contentSha256])
  @@index([duplicateOfPageId])
}

model DrawingExtractionAttempt {
  id                  String                     @id @default(cuid())
  pageId              String
  page                DrawingImportPage          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  stage               String
  sourceType          String
  routeTier           String
  parserVersion       String?
  profileVersion      String?
  promptVersion       String?
  requestedModel      String?
  resolvedModel       String?
  reasoningEffort     String?
  serviceTier         String?
  idempotencyKey      String                     @unique
  requestHash         String?
  inputTokens         Int                        @default(0)
  cachedInputTokens   Int                        @default(0)
  cacheWriteTokens    Int?
  outputTokens        Int                        @default(0)
  reasoningTokens     Int                        @default(0)
  estimatedCostUsd    Float                      @default(0)
  calculatedCostUsd   Float                      @default(0)
  latencyMs           Int                        @default(0)
  retryCount          Int                        @default(0)
  status              String
  responseId          String?
  resultJson          String?
  warningsJson        String?
  errorSummary        String?
  supersedesAttemptId String?
  supersedesAttempt   DrawingExtractionAttempt?  @relation("DrawingExtractionAttemptSupersedes", fields: [supersedesAttemptId], references: [id], onDelete: SetNull)
  supersededBy        DrawingExtractionAttempt[] @relation("DrawingExtractionAttemptSupersedes")
  createdAt           DateTime                   @default(now())

  @@index([pageId, stage])
  @@index([requestedModel])
  @@index([supersedesAttemptId])
}

model DrawingImportBomRow {
  id                       String                @id @default(cuid())
  jobId                    String
  job                      DrawingImportJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourcePageId             String
  sourcePage               DrawingImportPage     @relation(fields: [sourcePageId], references: [id], onDelete: Cascade)
  rowIndex                 Int
  item                     String?
  childPartNumber          String?
  description              String?
  quantityPerParent        Int?
  material                 String?
  revision                 String?
  parentAssemblyPartNumber String?
  sourceRegionJson         String
  rawCellsJson             String
  warningsJson             String?
  edge                     DrawingImportBomEdge?
  createdAt                DateTime              @default(now())

  @@unique([sourcePageId, rowIndex])
  @@index([jobId])
  @@index([childPartNumber])
  @@index([parentAssemblyPartNumber])
}

model DrawingImportBomEdge {
  id                String            @id @default(cuid())
  bomRowId          String            @unique
  bomRow            DrawingImportBomRow @relation(fields: [bomRowId], references: [id], onDelete: Cascade)
  parentPageId      String?
  parentPage        DrawingImportPage? @relation("DrawingImportParentPage", fields: [parentPageId], references: [id], onDelete: SetNull)
  childPageId       String?
  childPage         DrawingImportPage? @relation("DrawingImportChildPage", fields: [childPageId], references: [id], onDelete: SetNull)
  quantityPerParent Int?
  status            String
  warningsJson      String?
  createdAt         DateTime           @default(now())

  @@index([parentPageId])
  @@index([childPageId])
  @@index([status])
}

model DrawingTitleBlockProfile {
  id                  String    @id @default(cuid())
  profileIdentifier   String
  version             Int
  name                String
  businessCode        String?
  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  expectedLayoutJson  String
  anchorsJson         String
  fieldRulesJson      String
  validationStatsJson String?
  validationState     String    @default("PROPOSED")
  isActive            Boolean   @default(false)
  createdById         String?
  createdBy           User?     @relation("DrawingTitleBlockProfileCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([profileIdentifier, version])
  @@index([customerId, isActive])
  @@index([businessCode, isActive])
  @@index([validationState])
}
