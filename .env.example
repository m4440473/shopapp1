# NextAuth
# Update these URLs to the address other devices should use when accessing the
# app, e.g. http://192.168.1.25:3000 when sharing over your local network.
APP_BASE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate_a_unique_secret_for_this_environment"

# Prisma DB (Agent 1 default)
DATABASE_URL="file:./prisma/dev.db"

# Test harness (set to "true" only in local/dev sandbox environments)
TEST_MODE="false"

# OpenAI (Print Analyzer vision endpoint)
OPENAI_API_KEY="your_openai_api_key_here"
DRAWING_IMPORT_V2_TERRA_MODEL="gpt-5.4-mini"
DRAWING_IMPORT_V2_TERRA_REASONING="medium"
DRAWING_IMPORT_V2_LUNA_MODEL="gpt-5.6-luna"
DRAWING_IMPORT_V2_LUNA_REASONING="high"
DRAWING_IMPORT_V2_SOL="false"
