# NextAuth
# Update these URLs to the address other devices should use when accessing the
# app, e.g. http://192.168.1.25:3000 when sharing over your local network.
APP_BASE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXTAUTH_SECRET=c67778ff550bd909a42c5035288434d1ebb16cbe402f9f1d353a9c9713b0ab9f

# Prisma DB (Agent 1 default)
DATABASE_URL="file:./prisma/dev.db"

# Test harness (set to "true" only in local/dev sandbox environments)
TEST_MODE="false"

# OpenAI (Print Analyzer vision endpoint)
OPENAI_API_KEY="your_openai_api_key_here"

# Quote Drawing Import durable framework / V3 full-page extraction
DRAWING_IMPORT_V2_MODE="admin_beta"
DRAWING_IMPORT_V3_ENABLED="true"
DRAWING_IMPORT_V2_TERRA_MODEL="gpt-5.6-terra"
DRAWING_IMPORT_V2_TERRA_REASONING="medium"
DRAWING_IMPORT_V2_VERBOSITY="low"
# Optional response reasoning summary (auto | concise | detailed) and mode (standard | pro).
# Blank values preserve the existing API defaults; local trials can override these.
DRAWING_IMPORT_V2_REASONING_SUMMARY=""
DRAWING_IMPORT_V2_REASONING_MODE=""
DRAWING_IMPORT_V3_TERRA_REFINEMENT_REASONING="medium"
DRAWING_IMPORT_V2_MAX_OUTPUT_TOKENS="10000"
DRAWING_IMPORT_V2_PDF_AI_CONCURRENCY="2"
# The newer importer splits PDFs locally without OCR; the former OCR flag is ignored.
DRAWING_IMPORT_V2_LOCAL_AUTO_ACCEPT="false"
DRAWING_IMPORT_V2_SOFT_BUDGET_USD="6.4"
DRAWING_IMPORT_V2_HARD_BUDGET_USD="8"
